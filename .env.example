# Leave empty: the form posts to the site's own route (app/api/waitlist), which keeps the list in the project's Blob store
# (BLOB_READ_WRITE_TOKEN, which Vercel sets when the store is connected) and answers with the visitor's place.
# Only to send the form elsewhere: a URL that accepts a JSON POST of { email, consent, from }. Its origin is added to the
# site's Content-Security-Policy (connect-src) at build time, and unless it answers { code, place, brought } the page shows no place.
NEXT_PUBLIC_WAITLIST_ENDPOINT=

# Where people can write to us: on the legal page and in its privacy notice, and in the footer from 1024px wide.
# Set it before the waitlist opens: the privacy notice promises an address to ask for removal (the build warns if it is missing).
NEXT_PUBLIC_CONTACT_EMAIL=

# Resend's API key, for the one email a new address on the waitlist is sent, with its place and its link (lib/confirmation.ts). Unset, addresses are kept and nothing is sent.
# A founder makes the key at resend.com and sets it in the project's settings on Vercel; it never goes in this file or in the code.
RESEND_API_KEY=

# Who that email is from, for example "Meteorite <admin@meteorite.finance>": an address on a domain verified with Resend.
# Unset, it is the contact address above. Replies always come to the contact address.
WAITLIST_FROM=

# The site's public address, for example https://meteorite.example, once it has a domain. On Vercel it can stay empty: the project's production address is used, and shared links, the sitemap and robots.txt carry it.
NEXT_PUBLIC_SITE_URL=

